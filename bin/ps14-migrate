#!/usr/bin/env bash
#
# Migration of an older TYPO3 project to the ps14 template (TYPO3 v14).
# Runs inside the DDEV web container from the project root on a freshly imported dump:
#
#   ddev pull prod-v12 -y                # or another source
#   ddev exec vendor/bin/ps14-migrate
#
# Options:
#   --go-live   skip SQL scripts with the prefix DEV (development only)
#   --force     run even if the database has already been migrated
#   --help      show this help
#
# Project configuration (optional): config/migration/migration.env
#   MIGRATION_SKIP_COLUMNS   columns the schema update must not change, e.g. "tt_content.header_layout"
#   MIGRATION_CHECK_URLS     URLs (paths) checked after the migration, e.g. "/de/ /en/"
#
# Steps: pre SQL (package, project) -> schema update (add/change, without backend login) -> upgrade wizards
# -> post SQL (package, project) -> cache flush -> marker in sys_registry -> checks. Log: var/log/migration-<date>.log
#
# "extension:setup" is deliberately not called: it also applies column changes that are excluded here.

set -euo pipefail

readonly PACKAGE_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
readonly PROJECT_DIR="$(pwd)"
readonly CONFIG_DIR="${PROJECT_DIR}/config/migration"
readonly TYPO3_BIN="${PROJECT_DIR}/vendor/bin/typo3"
readonly REGISTRY_NAMESPACE="ps14_migration"
readonly REGISTRY_KEY="completed"

GO_LIVE=0
FORCE=0

for argument in "$@"; do
    case "${argument}" in
        --go-live) GO_LIVE=1 ;;
        --force) FORCE=1 ;;
        --help)
            sed -n '2,23p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "Unknown option: ${argument}" >&2
            exit 1
            ;;
    esac
done

MIGRATION_SKIP_COLUMNS=""
MIGRATION_CHECK_URLS=""

if [[ -f "${CONFIG_DIR}/migration.env" ]]; then
    # shellcheck source=/dev/null
    source "${CONFIG_DIR}/migration.env"
fi

mkdir -p "${PROJECT_DIR}/var/log"
readonly LOG_FILE="${PROJECT_DIR}/var/log/migration-$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "${LOG_FILE}") 2>&1

step() {
    echo
    echo "==> $*"
}

fail() {
    echo "ERROR: $*" >&2
    echo "Log: ${LOG_FILE}" >&2
    exit 1
}

# Executes all *.sql files of a directory in file name order. Files with the prefix DEV are skipped with --go-live.
run_sql_directory() {
    local directory="$1"
    local file name

    [[ -d "${directory}" ]] || return 0

    for file in "${directory}"/*.sql; do
        [[ -e "${file}" ]] || continue
        name="$(basename "${file}")"

        if [[ "${GO_LIVE}" -eq 1 && "${name}" == DEV* ]]; then
            echo "  skipped (go-live): ${name}"
            continue
        fi

        echo "  ${name}"
        mysql --batch < "${file}" || fail "SQL script failed: ${file}"
    done
}

typo3() {
    "${TYPO3_BIN}" "$@"
}

# Requirements
step "Requirements"
[[ -x "${TYPO3_BIN}" ]] || fail "vendor/bin/typo3 not found, run the script from the project root inside DDEV"
command -v mysql >/dev/null || fail "mysql client not found, run the script inside DDEV (ddev exec ...)"
mysql --batch -e "SELECT 1" >/dev/null || fail "no database connection"
echo "  project: ${PROJECT_DIR}"
echo "  package: ${PACKAGE_DIR}"
echo "  go-live: ${GO_LIVE}"
echo "  skip columns: ${MIGRATION_SKIP_COLUMNS:-none}"

completed="$(mysql --batch -N -e "SELECT COUNT(*) FROM sys_registry WHERE entry_namespace = '${REGISTRY_NAMESPACE}' AND entry_key = '${REGISTRY_KEY}'" 2>/dev/null || echo 0)"

if [[ "${completed}" != "0" && "${FORCE}" -eq 0 ]]; then
    fail "the database has already been migrated, import a fresh dump (or use --force)"
fi

# Pre SQL
step "Pre SQL"
run_sql_directory "${PACKAGE_DIR}/Resources/Private/Sql/pre"
run_sql_directory "${CONFIG_DIR}/sql/pre"

# Schema update (add/change without backend login). A second pass covers statements that depend on each other
# (e.g. an index on a column added in the same pass).
step "Schema update"
skip_options=()
for column in ${MIGRATION_SKIP_COLUMNS}; do
    skip_options+=("--skip=${column}")
done

if ! typo3 ps14:migration:update-schema "${skip_options[@]}"; then
    echo "  second pass"
    typo3 ps14:migration:update-schema "${skip_options[@]}" || fail "schema update failed"
fi

# Upgrade wizards (core, package, project)
step "Upgrade wizards"
typo3 cache:flush
typo3 upgrade:run --no-interaction || fail "upgrade wizards failed"

# Post SQL
step "Post SQL"
run_sql_directory "${PACKAGE_DIR}/Resources/Private/Sql/post"
run_sql_directory "${CONFIG_DIR}/sql/post"

# Finish
step "Cache"
typo3 cache:flush

mysql --batch -e "INSERT INTO sys_registry (entry_namespace, entry_key, entry_value) VALUES ('${REGISTRY_NAMESPACE}', '${REGISTRY_KEY}', 'i:$(date +%s);')"

# Checks
step "Checks"
echo "  open upgrade wizards:"
typo3 upgrade:list || true

if [[ -n "${MIGRATION_CHECK_URLS}" ]]; then
    base_url="${DDEV_PRIMARY_URL:-}"
    [[ -n "${base_url}" ]] || fail "DDEV_PRIMARY_URL not set, URL checks need DDEV"

    for url in ${MIGRATION_CHECK_URLS}; do
        status="$(curl -sk -o /dev/null -w "%{http_code}" "${base_url}${url}")"
        echo "  ${status} ${url}"
    done
fi

step "Done"
echo "  log: ${LOG_FILE}"
