{
    "name": "ps14/ps14_migration",
    "type": "typo3-cms-extension",
    "description": "Migration of older TYPO3 projects to the ps14 template (TYPO3 v14): schema update, SQL scripts and upgrade wizards. Installed only during a migration.",
    "keywords": [
        "TYPO3",
        "extension",
        "migration",
        "upgrade"
    ],
    "homepage": "https://ps14.de/",
    "license": "proprietary",
    "authors": [
        {
            "name": "Christian Pschorr",
            "email": "pschorr.christian@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "typo3/cms-core": "^14.3"
    },
    "autoload": {
        "psr-4": {
            "Ps14\\Migration\\": "Classes/"
        }
    },
    "bin": [
        "bin/ps14-migrate"
    ],
    "extra": {
        "typo3/cms": {
            "extension-key": "ps14_migration"
        },
        "branch-alias": {
            "dev-main": "14.x-dev"
        }
    }
}
